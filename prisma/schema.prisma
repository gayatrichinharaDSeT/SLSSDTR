// SLSSDTR — backend foundation schema (PostgreSQL via Prisma 7)
//
// Scope for this phase: authentication (Better Auth), contact messages,
// program enquiries (with DSeT-attribution fields prepared but not yet
// wired to a confirmed integration), customized-module requests, and a
// database-backed batch list. Deliberately excludes LMS/course/payment
// models — see ProgramEnquiry.programId and Batch.programId comments for
// how a future Program/Enrollment/Payment layer attaches without a
// rewrite.

generator client {
  provider = "prisma-client-js"
}

// Prisma 7: the connection URL lives in prisma.config.ts (for the CLI) and
// in the @prisma/adapter-pg adapter passed to PrismaClient (for the app) —
// not here. See prisma.config.ts and lib/prisma.ts.
datasource db {
  provider = "postgresql"
}

// USER/ADMIN cover this phase. Future values such as STUDENT, FACULTY,
// TRAINER, ENTREPRENEUR, SUPER_ADMIN can be appended to this enum later
// without a migration that touches existing rows.
enum Role {
  USER
  ADMIN
}

enum ContactStatus {
  NEW
  READ
  IN_PROGRESS
  RESOLVED
}

enum EnquiryStatus {
  NEW
  IN_PROGRESS
  RESOLVED
}

enum Profession {
  STUDENT
  FACULTY
  PROFESSIONAL
  ENTREPRENEUR
  SELF_EMPLOYED
  EXPERIENCED_NO_ENGAGEMENT
  OTHER
}

enum CompanyType {
  PHARMACEUTICAL
  MEDICAL_DEVICE
  MEDICAL_EQUIPMENT
  SURGICAL_CONSUMABLES
  HOSPITAL
  DISTRIBUTOR
  CONSULTING
  LABORATORY
  MARKET_RESEARCH
  TRAINING
  OTHERS
}

model User {
  id            String  @id @default(cuid())
  name          String
  email         String  @unique
  emailVerified Boolean @default(false)
  image         String?
  phone         String?
  organization  String?
  role          Role    @default(USER)

  // Profile / registration fields (Section 6). All nullable — a user is
  // never forced to complete these, and existing rows stay valid as-is.
  location        String?
  country         String?
  profession      Profession?
  professionOther String?

  // Conditional on profession = STUDENT
  courseName  String?
  institution String?
  currentYear String?

  // Conditional on profession = FACULTY (institution reused from above;
  // specialization is faculty-specific)
  specialization String?

  // Conditional on profession = PROFESSIONAL / ENTREPRENEUR / SELF_EMPLOYED
  companyName      String?
  companyType      CompanyType?
  companyTypeOther String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions                 Session[]
  accounts                 Account[]
  programEnquiries         ProgramEnquiry[]
  customizedModuleRequests CustomizedModuleRequest[]

  @@map("user")
}

// Better Auth's required session model.
model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

// Better Auth's required account model (stores the email/password
// credential as one "account" row per user, and would also hold OAuth
// provider tokens if a social provider is added later).
model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

// Better Auth's required verification model — backs both email
// verification and password reset tokens.
model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@map("verification")
}

model ContactMessage {
  id           String        @id @default(cuid())
  name         String
  email        String
  phone        String?
  organization String?
  interest     String?
  message      String
  status       ContactStatus @default(NEW)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([status])
  @@index([createdAt])
  @@map("contact_message")
}

// programId stores the stable slug from data/programs.ts (e.g.
// "student-ai"), not a foreign key — programs stay static content for
// this phase.
//
// IMPORTANT: this table is also written to directly by DSeT's own
// backend, outside this Prisma schema/migration history (confirmed via
// live introspection — it already carries source/external_system/
// external_reference/location/country/role/department/course_name/
// current_year/subject_specialization/company_name/company_type/metadata
// columns with 12 real rows). This model intentionally does NOT declare
// those columns: doing so now, from this side, would require Prisma to
// reconcile its migration history against a database that already
// diverged out-of-band, and risks an unintended ALTER/DROP against live,
// shared, DSeT-owned data. Do not add those fields here until the actual
// live column types/constraints have been confirmed with the DSeT team
// and reconciled via `prisma db pull`, not guessed at.
model ProgramEnquiry {
  id           String        @id @default(cuid())
  programId    String
  name         String
  email        String
  phone        String?
  organization String?
  message      String
  status       EnquiryStatus @default(NEW)
  // Plain text, matching DSeT's own `batch` convention on
  // academy_registrations — no FK to Batch, so it never blocks an insert
  // that doesn't set it.
  preferredBatch String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Nullable: guest visitors can submit enquiries without an account.
  // SetNull (not Cascade) so deleting a user never deletes the business
  // record of their enquiry.
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([programId])
  @@index([status])
  @@map("program_enquiry")
}

// A visitor's request for a custom training module, spanning one or more
// business departments — distinct from a ProgramEnquiry because it is not
// necessarily tied to one of the five published programs.
model CustomizedModuleRequest {
  id           String        @id @default(cuid())
  name         String
  email        String
  phone        String?
  organization String?
  // The 18 business departments (Section 7), stored as a native Postgres
  // text array rather than a join table — this is a simple multi-select
  // tag list, not a relation with its own attributes.
  departments  String[]
  programId    String?
  message      String?
  status       EnquiryStatus @default(NEW)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
  @@map("customized_module_request")
}

// Cohort batches, shared across all five programs (Section 5) — defined
// once here rather than hard-coded into program cards, program detail
// pages and any future enrollment UI independently.
model Batch {
  id           String   @id @default(cuid())
  label        String // "Batch 1", "Batch 2", "Batch 3"
  monthLabel   String // "November 2026", "December 2026", "January 2027"
  startsOn     DateTime // first of that month, for sorting
  isActive     Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isActive])
  @@map("batch")
}
